{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SoloOS immutable external action proposal",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "company_id",
    "kind",
    "target",
    "payload",
    "idempotency_key",
    "risk",
    "metadata"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "company_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "kind": {
      "enum": [
        "github.create_issue",
        "payment",
        "contract",
        "delete",
        "public_post",
        "binding_communication"
      ]
    },
    "target": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "body"
      ],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "body": {
          "type": "string",
          "maxLength": 60000
        }
      }
    },
    "idempotency_key": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{8,128}$"
    },
    "risk": {
      "const": "high"
    },
    "metadata": {
      "$ref": "#/$defs/metadata"
    }
  },
  "$defs": {
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "recorded_at",
        "currency",
        "timezone",
        "validation_status",
        "evidence",
        "provenance"
      ],
      "properties": {
        "source": {
          "type": "string",
          "minLength": 1
        },
        "recorded_at": {
          "type": "string",
          "format": "date-time"
        },
        "currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$"
        },
        "timezone": {
          "type": "string",
          "minLength": 1
        },
        "validation_status": {
          "enum": [
            "validated",
            "unverified",
            "rejected"
          ]
        },
        "evidence": {
          "enum": [
            "confirmed",
            "assumption",
            "estimate",
            "forecast"
          ]
        },
        "provenance": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
