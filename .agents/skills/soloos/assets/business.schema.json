{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:soloos:business:0.1",
  "title": "SoloOS Phase 1 business dataset",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "company", "coverage", "transactions"],
  "properties": {
    "schema_version": {"const": "0.1"},
    "company": {"$ref": "#/$defs/company"},
    "coverage": {"$ref": "#/$defs/coverage"},
    "cash_snapshot": {"$ref": "#/$defs/cash"},
    "transactions": {"type": "array", "items": {"$ref": "#/$defs/transaction"}}
  },
  "$defs": {
    "money": {"type": "string", "pattern": "^(0|[1-9][0-9]{0,14})(\\.[0-9]{1,4})?$"},
    "id": {"type": "string", "minLength": 1, "maxLength": 100},
    "metadata": {
      "type": "object", "additionalProperties": false,
      "required": ["source", "recorded_at", "currency", "timezone", "validation_status", "evidence", "provenance"],
      "properties": {
        "source": {"type": "string", "minLength": 1},
        "recorded_at": {"type": "string", "format": "date-time"},
        "currency": {"type": "string", "pattern": "^[A-Z]{3}$"},
        "timezone": {"type": "string", "minLength": 1},
        "validation_status": {"enum": ["validated", "unverified", "rejected"]},
        "evidence": {"enum": ["confirmed", "assumption", "estimate", "forecast"]},
        "provenance": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
      }
    },
    "company": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "name", "business_type", "minor_units", "synthetic", "metadata"],
      "properties": {
        "id": {"$ref": "#/$defs/id"}, "name": {"type": "string", "minLength": 1, "maxLength": 200},
        "business_type": {"enum": ["saas", "ecommerce", "creator", "freelance", "consulting", "digital-products", "custom"]},
        "minor_units": {"type": "integer", "minimum": 0, "maximum": 4},
        "synthetic": {"type": "boolean"}, "metadata": {"$ref": "#/$defs/metadata"}
      }
    },
    "coverage": {
      "type": "object", "additionalProperties": false,
      "required": ["start", "end", "complete", "metadata"],
      "properties": {
        "start": {"type": "string", "format": "date"}, "end": {"type": "string", "format": "date"},
        "complete": {"type": "boolean"}, "metadata": {"$ref": "#/$defs/metadata"}
      }
    },
    "cash": {
      "type": "object", "additionalProperties": false,
      "required": ["as_of", "available_cash", "metadata"],
      "properties": {
        "as_of": {"type": "string", "format": "date"},
        "available_cash": {"$ref": "#/$defs/money"}, "metadata": {"$ref": "#/$defs/metadata"}
      }
    },
    "transaction": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "company_id", "occurred_at", "kind", "amount", "category", "metadata"],
      "properties": {
        "id": {"$ref": "#/$defs/id"}, "company_id": {"$ref": "#/$defs/id"},
        "occurred_at": {"type": "string", "format": "date-time"},
        "kind": {"enum": ["revenue", "expense", "revenue_refund", "expense_refund", "financing_in", "financing_out"]},
        "amount": {"$ref": "#/$defs/money"}, "category": {"type": "string", "minLength": 1},
        "metadata": {"$ref": "#/$defs/metadata"}
      }
    }
  }
}
